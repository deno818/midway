{
  "name": "@midwayjs/security",
  "version": "4.0.0-beta.7",
  "description": "Midway Security Component",
  "main": "dist/index.js",
  "typings": "index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:crypto": "tsc src/crypto-utils.ts --outDir dist --target es2020 --module commonjs --esModuleInterop true --skipLibCheck true",
    "build:cardpool": "tsc src/cardPoolMatcher.ts src/generateCardPool.ts --outDir dist --target es2020 --module commonjs --esModuleInterop true --skipLibCheck true",
    "test": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand",
    "test:crypto": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand test/crypto-utils.test.ts",
    "test:cardpool": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand test/cardPoolMatcher.test.ts",
    "cov": "node -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand --coverage --forceExit",
    "demo": "npm run build:crypto && node -e \"const { XorWithKey, decrypt, bytesToLiteral, verifySign, parseJSONWithTypes, demo } = require('./dist/crypto-utils.js'); demo();\"",
    "demo:cardpool": "npm run build:cardpool && ts-node demo/cardPoolDemo.ts",
    "ci": "npm run test"
  },
  "keywords": [],
  "author": "",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "csrf": "3.1.0",
    "escape-html": "1.0.3",
    "nanoid": "3.3.11",
    "picomatch": "2.3.1",
    "platform": "1.3.6",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@midwayjs/core": "workspace:^",
    "@midwayjs/express": "workspace:^",
    "@midwayjs/faas": "workspace:^",
    "@midwayjs/koa": "workspace:^",
    "@midwayjs/mock": "workspace:^",
    "@midwayjs/web": "workspace:^"
  }
}
